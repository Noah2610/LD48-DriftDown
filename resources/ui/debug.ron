#![enable(implicit_some)]
Container(
    transform: (
        id:             "debug",
        x:              0.025,
        y:              0.025,
        z:              5.0,
        width:          0.5,
        height:         0.5,
        anchor:         BottomLeft,
        pivot:          BottomLeft,
        mouse_reactive: false,
        percent:        true,
        opaque:         false,
        // hidden:         true,
    ),

    children: [
        Label(
            transform: (
                id:             "debug_text",
                x:              0.0,
                y:              0.0,
                z:              0.0,
                width:          1.0,
                height:         1.0,
                anchor:         BottomLeft,
                pivot:          BottomLeft,
                mouse_reactive: false,
                percent:        true,
                opaque:         false,
            ),
            text: (
                text:      "DEBUG",
                font_size: 16.0,
                color:     (0.9, 0.9, 0.9, 1.0),
                font:      File("resources/fonts/undefined-medium.ttf", ("TTF", ())),
                align:     BottomLeft,
                line_mode: Wrap,
            ),
        ),

    ],
)
